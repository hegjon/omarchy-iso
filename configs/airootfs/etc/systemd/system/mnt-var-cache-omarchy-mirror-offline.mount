[Unit]
Description=Offline package mirror on the install target's mirror path
# The target-setup chroots run omarchy's own install scripts, whose pacman
# config addresses the [offline] repo at the same path it has on the live
# system; this shows the live mirror there inside the target. Started by
# prepare_target_setup -- systemctl start is idempotent, so the many phase
# units that share that helper cannot stack a second bind the way repeated
# mount --bind calls could.
RequiresMountsFor=/var/cache/omarchy/mirror/offline
# A group abort stops omarchy-install.target (the orchestrator's exit trap),
# and PartOf= takes this mount down with it.
PartOf=omarchy-install.target

[Mount]
What=/var/cache/omarchy/mirror/offline
Where=/mnt/var/cache/omarchy/mirror/offline
Type=none
Options=bind
