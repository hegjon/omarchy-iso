#!/usr/bin/ash
# The earliest feedback the ISO can put on screen: everything before this
# (bootloader load, kernel unpack) belongs to firmware. Plymouth's splash
# takes over a couple of seconds later, as soon as KMS is up, and holds the
# screen until the live system's tty1 script replaces it — this line only
# covers the seconds before that, and stays as the whole story on a machine
# whose console never gets a KMS driver.

run_earlyhook() {
    printf '\n  \033[90mStarting the installer...\033[0m\n' > /dev/console
}
