#!/usr/bin/ash
# The Omarchy logo on tty1 before anything else happens in the initramfs,
# where the installer's greeter will draw it: the layout and the reasons are
# in /usr/share/omarchy-iso/console-logo.sh. Plymouth is not in this
# initramfs, getty@tty1 keeps the VT (TTYVTDisallocate=no), and
# .automated_script.sh leaves the logo up until the greeter draws over it.
run_earlyhook() {
    [ -r /usr/share/omarchy-iso/console-logo.sh ] || return 0
    # shellcheck source=/dev/null
    . /usr/share/omarchy-iso/console-logo.sh
    omarchy_console_logo
}
