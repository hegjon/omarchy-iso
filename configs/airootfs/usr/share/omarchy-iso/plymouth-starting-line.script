# omarchy-starting-line: appended to the omarchy Plymouth theme on the live
# ISO only. The splash here always precedes the installer, so say so, in the
# same dim tone and position the console frames and greeter use — the text
# rides under the logo from the first splash frame to the wizard.
starting.text = Image.Text("Starting the installer...", 0.255, 0.282, 0.408);
starting.sprite = Sprite(starting.text);
starting.sprite.SetX(Window.GetWidth() / 2 - starting.text.GetWidth() / 2);
starting.sprite.SetY(Window.GetHeight() / 2 + logo.image.GetHeight() / 2 + 28);
starting.sprite.SetOpacity(1);
