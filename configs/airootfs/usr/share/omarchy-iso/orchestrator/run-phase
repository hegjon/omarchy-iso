#!/usr/bin/env bash
# Host one orchestrator phase in its own process, for the systemd phase
# units: `run-phase install_root_image "Unpacking root image"` is what
# omarchy-install-image.service execs. Sources the same stack main.sh loads
# (main.sh runs nothing when sourced), rebuilds the install context from the
# persisted inputs the unit's EnvironmentFile= handed us, and calls the one
# function. Its exit status is the unit's Result; its output is the journal,
# teed into the install log so the support artifact keeps the detail.
#
# The install's sequencing lives in the units' Requires=/After= edges, not
# here and not in a loop: the orchestrator starts the terminal unit and
# systemd walks the graph. What each phase owes the dashboard -- the
# state.json record of who is running, who finished and how long they took
# -- is written here, by the process that knows.
set -eEuo pipefail

phase=${1:?usage: run-phase <phase-function> [display-name]}
phase_name=${2:-$1}

# shellcheck disable=SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/main.sh"

declare -F "$phase" >/dev/null ||
  fail "run-phase: no such phase function: $phase"

ctx_from_env

# The journal keeps the raw stream; the install log (the support artifact
# the dashboard tails and `log` fetches) gets a filtered copy -- the shared
# log-filter.sed strips terminal control sequences and the archinstall-bash
# banners that would contradict a later failure (the dashboard applies the
# same filter to the orchestrator child's output). Best effort: an
# unwritable log (a test harness, a hand-run phase) must not cost the phase
# its output or its run.
if [[ -n ${CTX_LOG_PATH:-} ]] && touch "$CTX_LOG_PATH" 2>/dev/null; then
  exec > >(tee >(sed -u -f "$ORCHESTRATOR_DIR/log-filter.sed" >>"$CTX_LOG_PATH") 2>/dev/null) 2>&1
fi

# The library's view of the configuration, so any phase function is hostable
# here — the later phases read CFG_* and the PART_* planning the config parse
# produces. Reloading per process is the established pattern: config_load is
# deterministic from the JSON ctx_from_env resolved.
arch_init_library
arch_load_config

# The cross-phase state: what the old single-process install passed
# between steps for free, made explicit for the phase units. The parse
# above rebuilds everything derivable from the JSON; these are the values
# only the run itself could produce. The verified library edges: the disk
# phase's format-time PART_* discoveries (device nodes, partition numbers,
# the UUIDs mkfs assigned) feed the strap's Limine setup and kernel
# params, and the strap's INST_HELPER_FLAGS ledger feeds
# installer_finish's audit in the base phase. (INST_ZRAM_ENABLED is set
# and read within the strap's own process and does not belong here.) The
# orchestrator's own cross-phase state travels the same way: the
# target-setup memoization and the finalizer log's header/start-time,
# which the system and user phases must share -- per-process, the header
# was written twice and the two chroots saw different start times. Every
# phase restores the state and persists it back only when its run changed
# something, so the handoff needs no per-phase code and relay phases
# write nothing.
LIBRARY_STATE_VARS=(PART_DEVPATH PART_PARTN PART_PARTUUID PART_UUID
                    INST_HELPER_FLAGS
                    CTX_TARGET_SETUP_PREPARED CTX_OMARCHY_START_TIME
                    CTX_OMARCHY_START_EPOCH CTX_FINALIZER_HEADER_WRITTEN)

library_state_snapshot() {
  local v
  for v in "${LIBRARY_STATE_VARS[@]}"; do
    declare -p "$v" 2>/dev/null || true
  done
}

persist_library_state() {
  library_state_snapshot >"$CTX_STATE_DIR/library-state.sh"
}
# library-state helpers end

# shellcheck disable=SC1091
[[ ! -f "$CTX_STATE_DIR/library-state.sh" ]] || source "$CTX_STATE_DIR/library-state.sh"
LIBRARY_STATE_RESTORED=$(library_state_snapshot)

# The destruction boundary, enforced here rather than trusted to ordering:
# every hosted phase so far operates on the prepared target, and must never
# run before the disk phase has formatted and mounted it — not from a stray
# manual `systemctl start`, and not from a mis-edged future graph. A unit
# hosting a pre-format phase declares Environment=RUN_PHASE_NO_TARGET=1 to
# opt out. A loud failure, deliberately not a systemd Condition: conditions
# cannot read the env-provided target path, and a false condition skips
# with success — the graph would count the phase as done.
if [[ ${RUN_PHASE_NO_TARGET:-} != 1 ]] && ! mountpoint -q "$CTX_TARGET"; then
  fail "run-phase: $CTX_TARGET is not a mounted install target; refusing to run $phase before the disk phase"
fi

# The phase's stage mounts (image-top, factory-top) are systemd mounts with
# PartOf=omarchy-install.target: a mid-phase death is followed by the
# orchestrator stopping the target, and the group teardown unmounts them.
# This trap owns the failure record and the error handover.
phase_started_at=$(now)
run_phase_cleanup() {
  local status=$?
  ((status != 0)) || return 0
  # A signal (SIGTERM from the group abort, typically) is the install being
  # torn down around this phase, not the phase failing: the orchestrator
  # writes that story, and a 'failed' entry here would tell it twice.
  ((status < 128)) || return 0
  # The phase's own words, for the orchestrator's failure message: fail()
  # recorded them in this process, and the journal buries them under
  # command output and systemd's exit lines — hand them over directly.
  [[ -z ${ORCH_LAST_ERROR:-} ]] ||
    printf '%s' "$ORCH_LAST_ERROR" >"$CTX_STATE_DIR/phase-error" 2>/dev/null
  phases_leave "$phase_name" failed "$phase_started_at" \
    "${ORCH_LAST_ERROR:-phase exited with status $status}" 2>/dev/null || true
}
trap run_phase_cleanup EXIT

info "› $phase_name"
phases_enter "$phase_name"

"$phase"

# Reached only on success (set -e): record the phase, and hand this
# process's library state to the next phase's -- but only when this phase
# actually changed it. Relay phases stay read-only, which also makes them
# safe beside each other if the graph ever fans out.
phases_leave "$phase_name" ok "$phase_started_at"
[[ "$(library_state_snapshot)" == "$LIBRARY_STATE_RESTORED" ]] || persist_library_state
