#!/usr/bin/env bash
# Host one orchestrator phase function in its own process, for the systemd
# phase units: `run-phase install_root_image` is what
# omarchy-install-image.service execs. Sources the same stack main.sh loads
# (main.sh runs nothing when sourced), rebuilds the install context from the
# persisted inputs the unit's EnvironmentFile= handed us, and calls the one
# function. Its exit status is the unit's Result; its output is the journal.
set -eEuo pipefail

phase=${1:?usage: run-phase <phase-function>}

# shellcheck disable=SC1091
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/main.sh"

declare -F "$phase" >/dev/null ||
  fail "run-phase: no such phase function: $phase"

ctx_from_env

# The library's view of the configuration, so any phase function is hostable
# here — the later phases read CFG_* and the PART_* planning the config parse
# produces. Reloading per process is the established pattern, not a new one:
# the orchestrator itself calls arch_load_config once at pre-flight and again
# at the install phase, because config_load is deterministic from the JSON
# ctx_from_env resolved. installer_init only seeds this process's INST_ state.
arch_init_library
arch_load_config

# The library's cross-phase state: what the old single-process install
# passed between steps for free, made explicit for the phase units. The
# parse above rebuilds everything derivable from the JSON; these are the
# values only the run itself could produce -- the device nodes and UUIDs
# the partitioning tools assigned, and the ledger of completed steps that
# installer_finish audits (arch_init_library just reset it to virgin).
# Each phase restores the state here and persists it back on success, so
# the handoff needs no per-phase code and survives new state being added.
LIBRARY_STATE_VARS=(PART_DEVPATH PART_PARTN PART_PARTUUID PART_UUID
                    INST_HELPER_FLAGS INST_ZRAM_ENABLED)

persist_library_state() {
  local v
  for v in "${LIBRARY_STATE_VARS[@]}"; do
    declare -p "$v" 2>/dev/null || true
  done >"$CTX_STATE_DIR/library-state.sh"
}

# shellcheck disable=SC1091
[[ ! -f "$CTX_STATE_DIR/library-state.sh" ]] || source "$CTX_STATE_DIR/library-state.sh"

# The destruction boundary, enforced here rather than trusted to ordering:
# every hosted phase so far operates on the prepared target, and must never
# run before the disk phase has formatted and mounted it — not from a stray
# manual `systemctl start`, and not from a mis-edged future graph. A unit
# hosting a pre-format phase declares Environment=RUN_PHASE_NO_TARGET=1 to
# opt out. A loud failure, deliberately not a systemd Condition: conditions
# cannot read the env-provided target path, and a false condition skips
# with success — the orchestrator would count the phase as done.
if [[ ${RUN_PHASE_NO_TARGET:-} != 1 ]] && ! mountpoint -q "$CTX_TARGET"; then
  fail "run-phase: $CTX_TARGET is not a mounted install target; refusing to run $phase before the disk phase"
fi

# The phase's stage mounts (image-top, factory-top) are systemd mounts with
# PartOf=omarchy-install.target: a mid-phase death is followed by the
# orchestrator stopping the target, and the group teardown unmounts them —
# no per-process mount bookkeeping here. What this trap still owns is the
# error handover, on a failing exit only.
run_phase_cleanup() {
  local status=$?
  ((status != 0)) || return 0
  # The phase's own words, for the orchestrator's failure message: fail()
  # recorded them in this process, and the journal buries them under
  # sha256sum output and systemd's exit lines — hand them over directly.
  [[ -z ${ORCH_LAST_ERROR:-} ]] ||
    printf '%s' "$ORCH_LAST_ERROR" >"$CTX_STATE_DIR/phase-error" 2>/dev/null
}
trap run_phase_cleanup EXIT

"$phase"

# Reached only on success (set -e): hand this phase's library state to the
# next phase's process.
persist_library_state
