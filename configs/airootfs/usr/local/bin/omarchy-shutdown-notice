#!/bin/bash
# Say on tty1 that the live system goes down: Ctrl+Alt+Delete (or the power
# button) at the greeter otherwise ended in a blank screen after whatever the
# dying session printed. getty@tty1's ExecStopPost runs this
# (getty@tty1.service.d/omarchy-shutdown-notice.conf), so it writes once the
# greeter's session is gone and nothing else draws on tty1; when getty stops
# for any other reason than a shutdown it does nothing.
#
# Where the greeter is still up (the configurator leaves its tagline and hint
# rows in /run/omarchy-iso/greeter-rows until a Return), the notice takes the
# tagline's place under the logo and the hint goes; elsewhere it is alone,
# centred on a cleared screen. The cursor then waits on an empty row: systemd
# clears its status line on the console (a carriage return and an erase to the
# end of the line) wherever the cursor is, which took the notice away again.
# The kernel's messages go to tty12 (hooks/omarchy-logo), not here.

set -u

tty=${OMARCHY_NOTICE_TTY:-/dev/tty1}
run=${OMARCHY_RUN_DIR:-/run/omarchy-iso}

[[ $(systemctl is-system-running 2>/dev/null) == stopping ]] || exit 0
case $(systemctl list-jobs --no-legend 2>/dev/null) in
  *poweroff.target* | *halt.target*) text="Powering off..." ;;
  *) text="Rebooting..." ;;
esac

rows=25 cols=80
size=$(stty size <"$tty" 2>/dev/null) && [[ $size =~ ^[0-9]+\ [0-9]+$ ]] && { rows=${size% *}; cols=${size#* }; }
col=$(((cols - ${#text}) / 2 + 1))
((col < 1)) && col=1

if read -r tagline_row hint_row 2>/dev/null <"$run/greeter-rows" &&
  [[ $tagline_row =~ ^[0-9]+$ && $hint_row =~ ^[0-9]+$ ]]; then
  printf '\033[?25l\033[0m\033[%d;1H\033[2K\033[%d;1H\033[2K\033[%d;%dH%s\033[%d;1H' \
    "$tagline_row" "$hint_row" "$tagline_row" "$col" "$text" "$hint_row" >"$tty" 2>/dev/null
else
  printf '\033[?25l\033[0m\033[H\033[2J\033[%d;%dH%s\033[%d;1H' \
    "$((rows / 2))" "$col" "$text" "$((rows / 2 + 2))" >"$tty" 2>/dev/null
fi
exit 0
